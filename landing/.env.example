# Neon Postgres connection string (Pooled connection recommended).
# Get it from https://console.neon.tech → your project → Connection Details.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Canonical site origin used to build referral links (no trailing slash).
# Falls back to the request origin if unset.
NEXT_PUBLIC_SITE_URL="https://gantry.dev"
